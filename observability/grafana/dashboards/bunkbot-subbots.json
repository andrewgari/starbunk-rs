{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Subbot Triggers (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(bunkbot_bot_triggers_total[5m])",
          "legendFormat": "{{bot}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Triggers by Subbot",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "bunkbot_bot_triggers_total",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Messages Received",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "bunkbot_messages_received_total",
          "legendFormat": "messages",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Active Bots",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "expr": "bunkbot_active_bots",
          "legendFormat": "active",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Errors by Kind",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "bunkbot_errors_total",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Response Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(bunkbot_response_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(bunkbot_response_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(bunkbot_response_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Subbot Trigger Heatmap (hourly)",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "color": { "scheme": "Oranges" },
        "yAxis": { "unit": "" }
      },
      "targets": [
        {
          "expr": "increase(bunkbot_bot_triggers_total[1h])",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Subbot Trigger Traces",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }]
      },
      "targets": [
        {
          "expr": "{service_name=\"bunkbot\"} |= \"subbot triggered\" | logfmt | line_format \"{{.bot}} → {{.channel}} ({{.latency_ms}}ms)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Trigger Frequency — Top 10 Subbots (24h)",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "hidden" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "expr": "topk(10, increase(bunkbot_bot_triggers_total[24h]))",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Message Rate vs Trigger Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(bunkbot_messages_received_total[5m])",
          "legendFormat": "messages received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(bunkbot_bot_triggers_total[5m]))",
          "legendFormat": "total triggers",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["bunkbot", "subbots", "starbunk"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "BunkBot Subbots",
  "uid": "bunkbot-subbots",
  "version": 1
}
